{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": { "maxDuration": 10, "memory": 1024, "includeFiles": "node_modules/@ip-location-db/**" }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ]
}
